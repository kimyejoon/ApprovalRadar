{
  "name": "approvalradar-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "ApprovalRadar Monorepo (FE/BE)",
  "scripts": {
    "start:fe": "cd ApprovalRadar-FE && npm run dev",
    "start:be": "cd ApprovalRadar-BE && uvicorn main:app --host 0.0.0.0 --reload",
    "start": "concurrently \"npm run start:fe\" \"npm run start:be\""
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
